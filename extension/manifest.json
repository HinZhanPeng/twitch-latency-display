{
  "manifest_version": 3,
  "name": "Latency Catch-Up for Twitch",
  "version": "1.0.2",
  "description": "Shows live stream latency on the Twitch player and automatically catches up to the live edge.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Latency Catch-Up",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content/controller.js", "content/page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["shared/defaults.js", "content/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
